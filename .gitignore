# Rust
/target/
**/*.rs.bk

# OmniToaster portable data folder (never commit runtime data)
/OmniToasterData/
# The scratch folder every rule tells a session to develop against
# (`cargo run -p omnitoaster -- --data-dir ./tmp-data`). Same rule: it is
# runtime data, and it holds a database and logs.
/tmp-data/

# Release staging written by scripts/*.ps1
/release/

# Release-signing PRIVATE key: lives only in the OT_MINISIGN_KEY forge secret
# and the owner's offline backup. Only keys/minisign.pub is committed.
*.key
*.sec
minisign.key
omnitoaster-minisign.key
keys/*
!keys/README.md
!keys/minisign.pub

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
/Feasibility Study.txt
*.stackdump

